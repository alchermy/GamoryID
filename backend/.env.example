APP_NAME=GamoryID
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173
# ใช้ * สำหรับ ngrok; production ควรระบุ IP ของ reverse proxy หากทราบ
TRUSTED_PROXIES=
APP_TIMEZONE=Asia/Bangkok

APP_LOCALE=th
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=th_TH

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
LOG_DAILY_DAYS=14

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=gamoryid
DB_USERNAME=root
DB_PASSWORD=
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Generate with: php -r "echo base64_encode(random_bytes(32));"
CREDENTIAL_ENCRYPTION_KEY_V1=
CREDENTIAL_REAUTH_MINUTES=5

# SlipOK: POST {ENDPOINT}/api/line/apikey/{BRANCH_ID} พร้อม header x-authorization: {API_KEY}
SLIPOK_ENDPOINT=https://api.slipok.com
SLIPOK_API_KEY=
SLIPOK_BRANCH_ID=
# เลขบัญชีผู้รับที่คาดหวัง (ปล่อยว่างเพื่อข้ามการตรวจบัญชีผู้รับ)
SLIPOK_RECEIVER_ACCOUNT=
# ใช้เฉพาะ local/testing เพื่อทดสอบ flow โดยไม่เรียก SlipOK จริง
SLIPOK_TEST_BYPASS=false

# Discord App credentials from https://discord.com/developers/applications
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=
# ใช้เฉพาะ local/testing เพื่อทดสอบหน้าเชื่อมต่อโดยไม่เรียก Discord จริง
DISCORD_TEST_BYPASS=false
