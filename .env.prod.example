# Template for /opt/gamoryid/.env on the VPS. This ONE file is read by both
# docker-compose.yml (for ${DB_*}/${ACME_EMAIL} substitution) and Laravel
# itself (passed into app/worker/scheduler via `env_file:`).
#
# Copy this to the VPS as /opt/gamoryid/.env, fill in every <CHANGE_ME>,
# then `chmod 600` it. Never commit the real file.

APP_NAME=GamoryID
APP_ENV=production
# Generate with: php -r "echo 'base64:'.base64_encode(random_bytes(32));"
APP_KEY=<CHANGE_ME — new key, do not reuse the one from local dev>
APP_DEBUG=false
APP_URL=https://api.gamoryid.com
FRONTEND_URL=https://app.gamoryid.com
PUBLIC_WEB_URL=https://gamoryid.com
STOREFRONT_URL=https://gamoryid.com

LEGAL_TERMS_VERSION=2026-09-04
LEGAL_PRIVACY_VERSION=2026-09-04
LEGAL_EFFECTIVE_DATE=2026-09-04
LEGAL_CONTROLLER_NAME="นายธนวัฒน์ ว่องประสบโชค"
LEGAL_CONTROLLER_EMAIL=thanawat.won01@gmail.com
LEGAL_CONTROLLER_ADDRESS="62/137 ซ.เสรีไทย72 ถ.เสรีไทย แขวงมีนบุรี เขตมีนบุรี กรุงเทพมหานคร 10510"
# Caddy is the only thing between the internet and this container.
TRUSTED_PROXIES=*
APP_TIMEZONE=Asia/Bangkok

APP_LOCALE=th
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=th_TH

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning
LOG_DAILY_DAYS=14

# --- Database — also read by docker-compose.yml to configure the mysql container ---
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=gamoryid
DB_USERNAME=gamoryid
DB_PASSWORD=<CHANGE_ME — long random password>
# Only the db container's own init uses this; Laravel never sees it.
DB_ROOT_PASSWORD=<CHANGE_ME — different long random password>

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.gamoryid.com
SESSION_SECURE_COOKIE=true
SANCTUM_STATEFUL_DOMAINS=app.gamoryid.com

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# No Redis on the 2GB tier — see the deploy runbook.

# --- Resend SMTP relay — see the runbook's SMTP setup section ---
MAIL_MAILER=smtp
MAIL_HOST=smtp.resend.com
MAIL_PORT=587
MAIL_USERNAME=resend
MAIL_PASSWORD=<CHANGE_ME — Resend API key>
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@gamoryid.com"
MAIL_FROM_NAME="GamoryID"

VITE_APP_NAME="${APP_NAME}"

# Generate with: php -r "echo base64_encode(random_bytes(32));"
CREDENTIAL_ENCRYPTION_KEY_V1=<CHANGE_ME — new key, do not reuse the one from local dev>
CREDENTIAL_REAUTH_MINUTES=5

SLIPOK_ENDPOINT=https://api.slipok.com
SLIPOK_API_KEY=<CHANGE_ME>
SLIPOK_BRANCH_ID=<CHANGE_ME>
SLIPOK_RECEIVER_ACCOUNT=
SLIPOK_TEST_BYPASS=false

DISCORD_APPLICATION_ID=<CHANGE_ME>
DISCORD_PUBLIC_KEY=<CHANGE_ME>
DISCORD_BOT_TOKEN=<CHANGE_ME>
DISCORD_TEST_BYPASS=false

# --- Caddy / Let's Encrypt ---
ACME_EMAIL=thanawat.won01@gmail.com
