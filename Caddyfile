# Merchant SPA (React) — client-side routed, so unknown paths fall back to index.html.
app.gamoryid.com {
	root * /srv/app
	encode gzip
	try_files {path} /index.html
	file_server
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
	}
}

# Backend API — plain HTTP inside the docker network, Caddy is the only
# thing that ever speaks TLS to the outside world.
api.gamoryid.com {
	encode gzip
	reverse_proxy app:8000
}

# phpMyAdmin — private DB console. The public URL is gated by HTTP basic
# auth (Caddy, bcrypt); phpMyAdmin then auto-connects with the app DB user.
# Rotate the password with:
#   docker compose exec web caddy hash-password --plaintext 'new-pass'
# and replace the hash below. Keep this behind Cloudflare's proxy.
console-x7k2.gamoryid.com {
	encode gzip
	basic_auth {
		admin $2a$14$HpA.942JyggyMl/PlP/sc.6E1J/gjKc9MFXnPjbEMXn4cn8aDwsiG
	}
	reverse_proxy pma:80
	header {
		X-Frame-Options DENY
		X-Content-Type-Options nosniff
		Referrer-Policy no-referrer
	}
}

# Public storefront (React) — same SPA fallback pattern as the merchant app.
gamoryid.com, www.gamoryid.com {
	encode gzip

	# The backend generates the real sitemap (every storefront + listing URL)
	# and a matching robots.txt — serve those from the API, not the static
	# 2-URL fallback baked into the SPA bundle.
	@seo path /sitemap.xml /robots.txt
	reverse_proxy @seo app:8000

	root * /srv/public
	try_files {path} /index.html
	file_server
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
}
